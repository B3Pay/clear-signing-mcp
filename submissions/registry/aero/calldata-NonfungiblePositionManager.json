{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "contract": {
      "deployments": [
        { "chainId": 1, "address": "0x4857DB576eE0e45F10525eC59527BfD10beeC60b" },
        { "chainId": 10, "address": "0x4857DB576eE0e45F10525eC59527BfD10beeC60b" },
        { "chainId": 8453, "address": "0x4857DB576eE0e45F10525eC59527BfD10beeC60b" },
        { "chainId": 42161, "address": "0x4857DB576eE0e45F10525eC59527BfD10beeC60b" }
      ]
    }
  },
  "metadata": {
    "owner": "Aero",
    "contractName": "Slipstream Positions NFT",
    "info": { "url": "https://aero.xyz" },
    "enums": { "operatorAccess": { "true": "Grant", "false": "Revoke" } }
  },
  "display": {
    "formats": {
      "approve(address to,uint256 tokenId)": {
        "intent": "Approve position operator",
        "interpolatedIntent": "Allow {to} to withdraw and transfer position NFT {tokenId}",
        "fields": [
          {
            "path": "to",
            "label": "Operator",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] }
          },
          { "path": "tokenId", "label": "Position", "format": "nftName", "params": { "collectionPath": "@.to" } }
        ]
      },
      "burn(uint256 tokenId)": {
        "intent": "Burn empty position NFT",
        "interpolatedIntent": "Burn empty position NFT {tokenId}",
        "fields": [
          { "path": "tokenId", "label": "Position", "format": "nftName", "params": { "collectionPath": "@.to" } },
          { "path": "@.value", "label": "ETH Sent", "format": "amount", "visible": { "mustMatch": [0] } }
        ]
      },
      "collect((uint256 tokenId,address recipient,uint128 amount0Max,uint128 amount1Max) params)": {
        "intent": "Collect from position",
        "interpolatedIntent": "Collect up to {params.amount0Max} token0 and up to {params.amount1Max} token1 (raw units) owed to position {params.tokenId}, sent to {params.recipient}. The zero address keeps them in this contract, where any caller can sweep them",
        "fields": [
          { "path": "params.tokenId", "label": "Position", "format": "nftName", "params": { "collectionPath": "@.to" } },
          { "path": "params.amount0Max", "label": "Max Token0 (raw)", "format": "raw" },
          { "path": "params.amount1Max", "label": "Max Token1 (raw)", "format": "raw" },
          {
            "path": "params.recipient",
            "label": "Recipient",
            "format": "addressName",
            "params": { "types": ["eoa", "wallet"], "sources": ["local", "ens"] }
          },
          { "path": "@.value", "label": "ETH Sent", "format": "amount", "visible": { "mustMatch": [0] } }
        ]
      },
      "decreaseLiquidity((uint256 tokenId,uint128 liquidity,uint256 amount0Min,uint256 amount1Min,uint256 deadline) params)": {
        "intent": "Decrease liquidity",
        "interpolatedIntent": "Remove {params.liquidity} liquidity from position {params.tokenId}: at least {params.amount0Min} token0 and {params.amount1Min} token1 (raw units) become owed to the position; nothing is transferred until collect",
        "fields": [
          { "path": "params.tokenId", "label": "Position", "format": "nftName", "params": { "collectionPath": "@.to" } },
          { "path": "params.liquidity", "label": "Liquidity to Remove", "format": "raw" },
          { "path": "params.amount0Min", "label": "Min Token0 Due (raw)", "format": "raw" },
          { "path": "params.amount1Min", "label": "Min Token1 Due (raw)", "format": "raw" },
          { "path": "params.deadline", "label": "Deadline", "format": "date", "params": { "encoding": "timestamp" } },
          { "path": "@.value", "label": "ETH Sent", "format": "amount", "visible": { "mustMatch": [0] } }
        ]
      },
      "increaseLiquidity((uint256 tokenId,uint256 amount0Desired,uint256 amount1Desired,uint256 amount0Min,uint256 amount1Min,uint256 deadline) params)": {
        "intent": "Add to liquidity position",
        "interpolatedIntent": "Add up to {params.amount0Desired} token0 and up to {params.amount1Desired} token1 (raw units) to position {params.tokenId}",
        "fields": [
          { "path": "params.tokenId", "label": "Position", "format": "nftName", "params": { "collectionPath": "@.to" } },
          { "path": "params.amount0Desired", "label": "Max Token0 (raw)", "format": "raw" },
          { "path": "params.amount1Desired", "label": "Max Token1 (raw)", "format": "raw" },
          { "path": "params.amount0Min", "label": "Min Token0 (raw)", "format": "raw" },
          { "path": "params.amount1Min", "label": "Min Token1 (raw)", "format": "raw" },
          { "path": "@.value", "label": "ETH Sent", "format": "amount" },
          { "path": "params.deadline", "label": "Deadline", "format": "date", "params": { "encoding": "timestamp" } }
        ]
      },
      "mint((address token0,address token1,int24 tickSpacing,int24 tickLower,int24 tickUpper,uint256 amount0Desired,uint256 amount1Desired,uint256 amount0Min,uint256 amount1Min,address recipient,uint256 deadline,uint160 sqrtPriceX96) params)": {
        "intent": "Open liquidity position",
        "interpolatedIntent": "Add up to {params.amount0Desired} and up to {params.amount1Desired} to a new position for {params.recipient}",
        "fields": [
          {
            "path": "params.amount0Desired",
            "label": "Maximum to Add",
            "format": "tokenAmount",
            "params": { "tokenPath": "params.token0" }
          },
          {
            "path": "params.amount1Desired",
            "label": "Maximum to Add",
            "format": "tokenAmount",
            "params": { "tokenPath": "params.token1" }
          },
          {
            "path": "params.amount0Min",
            "label": "Minimum to Add",
            "format": "tokenAmount",
            "params": { "tokenPath": "params.token0" }
          },
          {
            "path": "params.amount1Min",
            "label": "Minimum to Add",
            "format": "tokenAmount",
            "params": { "tokenPath": "params.token1" }
          },
          { "path": "@.value", "label": "ETH Sent", "format": "amount" },
          { "path": "params.tickSpacing", "label": "Pool Tick Spacing", "format": "raw" },
          {
            "path": "params.recipient",
            "label": "Position Recipient",
            "format": "addressName",
            "params": { "types": ["eoa", "wallet"], "sources": ["local", "ens"] }
          },
          { "path": "params.deadline", "label": "Deadline", "format": "date", "params": { "encoding": "timestamp" } },
          { "path": "params.tickLower", "label": "Lower Tick", "format": "raw" },
          { "path": "params.tickUpper", "label": "Upper Tick", "format": "raw" },
          { "path": "params.sqrtPriceX96", "label": "New Pool Sqrt Price", "format": "raw", "visible": { "ifNotIn": [0] } },
          { "path": "params.token0", "label": "Token 0", "visible": "never" },
          { "path": "params.token1", "label": "Token 1", "visible": "never" }
        ]
      },
      "multicall(bytes[] data)": {
        "intent": "Batch position actions",
        "interpolatedIntent": "Send {@.value} and run every action below in one transaction; if one action fails, the whole transaction reverts",
        "fields": [
          { "path": "@.value", "label": "ETH Sent", "format": "amount" },
          { "path": "data.[]", "label": "Action", "format": "calldata", "params": { "calleePath": "@.to", "amountPath": "@.value" } }
        ]
      },
      "setApprovalForAll(address operator,bool approved)": {
        "intent": "Set operator for all NFTs",
        "interpolatedIntent": "{approved} {operator} access to withdraw and transfer all your position NFTs",
        "fields": [
          { "path": "approved", "label": "Access", "format": "enum", "params": { "$ref": "$.metadata.enums.operatorAccess" } },
          {
            "path": "operator",
            "label": "Operator",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"], "sources": ["local", "ens"] }
          }
        ]
      }
    }
  }
}
