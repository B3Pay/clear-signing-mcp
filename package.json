{
  "name": "@b3pay/clear-signing-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "An MCP server that lets AI agents check, explain and simulate EVM calls with ERC-7730 clear signing, before a person signs anything.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "erc-7730",
    "clear-signing",
    "ethereum",
    "agents",
    "viem"
  ],
  "license": "MIT",
  "author": "Behrad Deylami",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B3Pay/clear-signing-mcp.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.28.0",
  "bin": {
    "clear-signing-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/live",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@ethereum-sourcify/clear-signing": "0.3.1",
    "@modelcontextprotocol/server": "2.4.0",
    "viem": "2.57.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@foundry-rs/anvil": "1.7.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
