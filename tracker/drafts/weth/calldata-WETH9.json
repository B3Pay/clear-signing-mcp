{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "contract": {
      "deployments": [
        {
          "chainId": 8453,
          "address": "0x4200000000000000000000000000000000000006"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Wrapped Ether (WETH)",
    "contractName": "WETH9",
    "info": {
      "url": "https://weth.io"
    }
  },
  "display": {
    "formats": {
      "approve(address guy,uint256 wad)": {
        "intent": "Approve",
        "fields": [
          {
            "path": "wad",
            "label": "Amount to approve",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "@.to"
            }
          },
          {
            "path": "guy",
            "label": "Guy",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "contract"
              ],
              "sources": [
                "local",
                "ens"
              ]
            }
          }
        ],
        "interpolatedIntent": "Approve {wad}"
      },
      "withdraw(uint256 wad)": {
        "intent": "Withdraw",
        "fields": [
          {
            "path": "wad",
            "label": "Amount to withdraw",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "@.to"
            }
          }
        ],
        "interpolatedIntent": "Withdraw {wad}"
      },
      "deposit()": {
        "intent": "Deposit",
        "fields": [
          {
            "path": "@.value",
            "label": "Amount to deposit",
            "format": "amount"
          }
        ],
        "interpolatedIntent": "Deposit {@.value}"
      },
      "transfer(address dst,uint256 wad)": {
        "intent": "Transfer",
        "fields": [
          {
            "path": "wad",
            "label": "Amount to send",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "@.to"
            }
          },
          {
            "path": "dst",
            "label": "Dst",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "contract"
              ],
              "sources": [
                "local",
                "ens"
              ]
            }
          }
        ],
        "interpolatedIntent": "Transfer {wad}"
      }
    }
  }
}
