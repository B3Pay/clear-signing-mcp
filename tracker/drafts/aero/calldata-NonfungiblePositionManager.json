  "display": {
    "formats": {
      "multicall(bytes[] data)": {
        "intent": "Multicall",
        "fields": [
          {
            "path": "@.value",
            "label": "Value sent",
            "format": "amount"
          },
          {
            "path": "data.[]",
            "label": "Action",
            "format": "calldata",
            "params": {
              "calleePath": "@.to",
              "amountPath": "@.value"
            }
          }
        ]
      },
      "mint((address token0,address token1,int24 tickSpacing,int24 tickLower,int24 tickUpper,uint256 amount0Desired,uint256 amount1Desired,uint256 amount0Min,uint256 amount1Min,address recipient,uint256 deadline,uint160 sqrtPriceX96) params)": {
        "intent": "Mint",
        "fields": [
          {
            "path": "params.amount0Desired",
            "label": "Maximum to mint",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "params.token0"
            }
          },
          {
            "path": "@.value",
            "label": "Value sent",
            "format": "amount"
          },
          {
            "path": "params.amount1Desired",
            "label": "Maximum to mint",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "params.token1"
            }
          },
          {
            "path": "params.amount0Min",
            "label": "Minimum to mint",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "params.token0"
            }
          },
          {
            "path": "params.amount1Min",
            "label": "Minimum to mint",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "params.token1"
            }
          },
          {
            "path": "params.tickSpacing",
            "label": "Tick spacing",
            "format": "raw"
          },
          {
            "path": "params.tickLower",
            "label": "Tick lower",
            "format": "raw"
          },
          {
            "path": "params.tickUpper",
            "label": "Tick upper",
            "format": "raw"
          },
          {
            "path": "params.recipient",
            "label": "Recipient",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "contract"
              ],
              "sources": [
                "local",
                "ens"
              ]
            }
          },
          {
            "path": "params.deadline",
            "label": "Deadline",
            "format": "date",
            "params": {
              "encoding": "timestamp"
            }
          },
          {
            "path": "params.sqrtPriceX96",
            "label": "Sqrt price X96",
            "format": "raw"
          },
          {
            "path": "params.token0",
            "label": "Token 0",
            "visible": "never"
          },
          {
            "path": "params.token1",
            "label": "Token 1",
            "visible": "never"
          }
        ],
        "interpolatedIntent": "Mint {params.amount0Desired}"
      },
