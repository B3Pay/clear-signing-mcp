# Copy to .env (gitignored) and run `node --env-file=.env dist/cli.js`, or set
# these in your MCP client's configuration. An RPC URL can carry an API key:
# never commit one.

# RPC per chain. Simulation needs one that supports eth_simulateV1.
# RPC_URL_1=https://your-ethereum-rpc
# RPC_URL_8453=https://your-base-rpc

# 0 stops the fallback to viem's public RPCs.
# CLEAR_SIGNING_PUBLIC_RPC=1

# Registry source and trusted auditors.
# CLEAR_SIGNING_REGISTRY_REPO=ethereum/clear-signing-erc7730-registry
# CLEAR_SIGNING_REGISTRY_REF=master
# CLEAR_SIGNING_TRUSTED_ATTESTERS=0x3846c3A30E62075Fa916216b35EF04B8F53931f6

# SOURCIFY_SERVER_URL=https://sourcify.dev/server
# CLEAR_SIGNING_TIMEOUT_MS=10000
# CLEAR_SIGNING_SERVICE_LINK=1
